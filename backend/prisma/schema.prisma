generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  fullName       String   @db.VarChar(100)
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @db.VarChar(255)
  phone          String?  @db.VarChar(20)
  role           UserRole @default(CUSTOMER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  loyalty_points Int      @default(0)

  carts                carts?
  orders               orders[]
  loyalty_transactions loyalty_transactions[]

  @@map("users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int      @default(1)
  size       String   @default("M") @db.VarChar(20)
  unit_price Decimal  @db.Decimal(12, 2)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  toppings   Json     @default("[]")
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_items_cart")
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_items_product")
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @db.Timestamp(6)
  cart_items cart_items[]
  users      User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_carts_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id           Int      @id @default(autoincrement())
  order_id     Int
  product_id   Int
  product_name String   @db.VarChar(150)
  quantity     Int
  size         String   @default("M") @db.VarChar(20)
  unit_price   Decimal  @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  toppings     Json     @default("[]")
  orders       orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_items_order")
  products     products @relation(fields: [product_id], references: [id], onUpdate: NoAction, map: "fk_order_items_product")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id               Int      @id @default(autoincrement())
  user_id          Int
  total_amount     Decimal  @default(0) @db.Decimal(12, 2)
  status           String   @default("PENDING") @db.VarChar(30)
  recipient_name   String   @db.VarChar(100)
  recipient_phone  String   @db.VarChar(20)
  delivery_address String
  note             String?
  payment_method   String   @default("COD") @db.VarChar(30)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @default(now()) @db.Timestamp(6)

  promotion_code          String?                      @db.VarChar(50)
  discount_amount         Decimal                      @default(0) @db.Decimal(12, 2)
  ingredient_reservations OrderIngredientReservation[]
  order_items             order_items[]
  users                   User                         @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_orders_user")
  payments                payments[]
  loyalty_transactions    loyalty_transactions[]

  @@map("orders")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id           Int             @id @default(autoincrement())
  name         String          @db.VarChar(150)
  description  String?
  price        Decimal         @db.Decimal(12, 2)
  image_url    String?         @db.VarChar(500)
  category     String?         @db.VarChar(100)
  is_available Boolean         @default(true)
  created_at   DateTime        @default(now()) @db.Timestamp(6)
  updated_at   DateTime        @default(now()) @db.Timestamp(6)
  cart_items   cart_items[]
  order_items  order_items[]
  recipes      ProductRecipe[]
  stock        Int             @default(100)
  version      Int             @default(0)
}

model payments {
  id               Int      @id @default(autoincrement())
  order_id         Int
  idempotency_key  String   @unique @db.VarChar(255)
  payment_method   String   @db.VarChar(30)
  simulate_failure Boolean  @default(false)
  status           String   @default("PROCESSING") @db.VarChar(30)
  success          Boolean?
  result           Json?
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @default(now()) @db.Timestamp(6)

  orders orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_payments_order")

  @@map("payments")
}

model promotion_codes {
  id                   Int       @id @default(autoincrement())
  code                 String    @unique @db.VarChar(50)
  discount_type        String    @db.VarChar(20)
  discount_value       Decimal   @db.Decimal(12, 2)
  minimum_order_amount Decimal   @default(0) @db.Decimal(12, 2)
  starts_at            DateTime  @default(now()) @db.Timestamp(6)
  expires_at           DateTime? @db.Timestamp(6)
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now()) @db.Timestamp(6)

  @@map("promotion_codes")
}

model loyalty_transactions {
  id          Int      @id @default(autoincrement())
  user_id     Int
  order_id    Int      @unique
  points      Int
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamp(6)

  users  User   @relation(fields: [user_id], references: [id], onDelete: Restrict, map: "fk_loyalty_user")
  orders orders @relation(fields: [order_id], references: [id], onDelete: Restrict, map: "fk_loyalty_order")

  @@index([user_id], map: "idx_loyalty_transactions_user_id")
  @@map("loyalty_transactions")
}

model Ingredient {
  id                 Int                          @id @default(autoincrement())
  name               String                       @unique @db.VarChar(150)
  unit               String                       @db.VarChar(20)
  stock              Decimal                      @default(0) @db.Decimal(12, 3)
  version            Int                          @default(1)
  created_at         DateTime                     @default(now()) @db.Timestamp(6)
  updated_at         DateTime                     @default(now()) @updatedAt @db.Timestamp(6)
  order_reservations OrderIngredientReservation[]
  product_recipes    ProductRecipe[]
  topping_recipes    ToppingRecipe[]

  @@map("ingredients")
}

model ProductRecipe {
  id            Int     @id @default(autoincrement())
  product_id    Int
  ingredient_id Int
  size          String  @default("M") @db.VarChar(1)
  quantity      Decimal @db.Decimal(12, 3)

  product    products   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Restrict)

  @@unique([product_id, size, ingredient_id])
  @@index([ingredient_id])
  @@map("product_recipes")
}

model ToppingRecipe {
  id            Int     @id @default(autoincrement())
  topping_name  String  @db.VarChar(100)
  ingredient_id Int
  quantity      Decimal @db.Decimal(12, 3)

  ingredient Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Restrict)

  @@unique([topping_name, ingredient_id])
  @@index([ingredient_id])
  @@map("topping_recipes")
}

model OrderIngredientReservation {
  id            Int      @id @default(autoincrement())
  order_id      Int
  ingredient_id Int
  quantity      Decimal  @db.Decimal(12, 3)
  status        String   @default("RESERVED") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(6)

  order      orders     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredient_id], references: [id], onDelete: Restrict)

  @@unique([order_id, ingredient_id])
  @@index([ingredient_id, status])
  @@map("order_ingredient_reservations")
}

enum UserRole {
  CUSTOMER
  ADMIN
}
